# Copy to .env.local and fill in. These values end up inside the app, so never put secret keys here.
# Supabase dashboard -> Project Settings -> API Keys (publishable key) and Data API (URL).
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# Google Cloud Console -> APIs & Services -> Credentials -> the "Web application" OAuth client ID.
# The same ID goes into Supabase -> Authentication -> Sign In / Providers -> Google -> Client IDs.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=1234567890-xxxx.apps.googleusercontent.com

# iPhone only: the "iOS" OAuth client ID (bundle ID com.tablemeet.app). Also add it to Supabase's Google provider
# Client IDs (comma-separated, after the web one). Empty = no Google sign-in on iPhone (Sign in with Apple still works).
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=

# Testing only: true opens the home screen without signing in. Keep false (or remove) for real builds.
EXPO_PUBLIC_SKIP_LOGIN=false


# Phone check (SMS code) after Google sign-in. false until an SMS provider is set up in Supabase; set true before
# launch, together with app_settings.require_phone_verification = true in the database.
EXPO_PUBLIC_REQUIRE_PHONE=false

# The admin website (web/, on Vercel), without a trailing slash. Redemption QR codes link to <this>/r/<code>, and the
# Privacy Policy links to <this>/delete-account. Must match the real address before you build for testers.
EXPO_PUBLIC_WEB_URL=https://your-tablemeet-site.vercel.app

# Shown in the Terms of Use and Privacy Policy. Leave empty until you have them (generic wording is used); fill in
# before publishing. Use a public support address, not a personal one.
EXPO_PUBLIC_BUSINESS_NAME=
EXPO_PUBLIC_CONTACT_EMAIL=

# Google AdMob "App open" ad unit (the full-screen ad when the app opens / comes back) for people without TableMeet
# Plus. Empty = Google's test ad. The AdMob *app* ID is in app.json (react-native-google-mobile-ads plugin) and needs
# a new native build when it changes.
EXPO_PUBLIC_ADMOB_APP_OPEN_ID=
