{
  "expo": {
    "name": "TableMeet",
    "slug": "table-meet",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "tablemeet",
    "userInterfaceStyle": "dark",
    "ios": {
      "icon": "./assets/images/icon.png",
      "bundleIdentifier": "com.tablemeet.app",
      "supportsTablet": false,
      "usesAppleSignIn": true,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#000000",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.tablemeet.app",
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "plugins": [
      "expo-router",
      [
        "expo-font",
        {
          "android": {
            "fonts": [
              {
                "fontFamily": "Figtree",
                "fontDefinitions": [
                  {
                    "path": "./assets/fonts/Figtree_400Regular.ttf",
                    "weight": 400
                  },
                  {
                    "path": "./assets/fonts/Figtree_500Medium.ttf",
                    "weight": 500
                  },
                  {
                    "path": "./assets/fonts/Figtree_600SemiBold.ttf",
                    "weight": 600
                  },
                  {
                    "path": "./assets/fonts/Figtree_700Bold.ttf",
                    "weight": 700
                  },
                  {
                    "path": "./assets/fonts/Figtree_800ExtraBold.ttf",
                    "weight": 800
                  }
                ]
              },
              {
                "fontFamily": "Bricolage Grotesque",
                "fontDefinitions": [
                  {
                    "path": "./assets/fonts/BricolageGrotesque_500Medium.ttf",
                    "weight": 500
                  },
                  {
                    "path": "./assets/fonts/BricolageGrotesque_600SemiBold.ttf",
                    "weight": 600
                  },
                  {
                    "path": "./assets/fonts/BricolageGrotesque_700Bold.ttf",
                    "weight": 700
                  },
                  {
                    "path": "./assets/fonts/BricolageGrotesque_800ExtraBold.ttf",
                    "weight": 800
                  }
                ]
              },
              {
                "fontFamily": "Anuphan",
                "fontDefinitions": [
                  {
                    "path": "./assets/fonts/Anuphan_400Regular.ttf",
                    "weight": 400
                  },
                  {
                    "path": "./assets/fonts/Anuphan_500Medium.ttf",
                    "weight": 500
                  },
                  {
                    "path": "./assets/fonts/Anuphan_600SemiBold.ttf",
                    "weight": 600
                  },
                  {
                    "path": "./assets/fonts/Anuphan_700Bold.ttf",
                    "weight": 700
                  }
                ]
              }
            ]
          },
          "ios": {
            "fonts": [
              "./assets/fonts/Figtree_400Regular.ttf",
              "./assets/fonts/Figtree_500Medium.ttf",
              "./assets/fonts/Figtree_600SemiBold.ttf",
              "./assets/fonts/Figtree_700Bold.ttf",
              "./assets/fonts/Figtree_800ExtraBold.ttf",
              "./assets/fonts/BricolageGrotesque_500Medium.ttf",
              "./assets/fonts/BricolageGrotesque_600SemiBold.ttf",
              "./assets/fonts/BricolageGrotesque_700Bold.ttf",
              "./assets/fonts/BricolageGrotesque_800ExtraBold.ttf",
              "./assets/fonts/Anuphan_400Regular.ttf",
              "./assets/fonts/Anuphan_500Medium.ttf",
              "./assets/fonts/Anuphan_600SemiBold.ttf",
              "./assets/fonts/Anuphan_700Bold.ttf"
            ]
          }
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0A0612",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200
        }
      ],
      "expo-sqlite",
      "expo-localization",
      "expo-apple-authentication",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "TableMeet uses your location to show partner places near you and to check you in when you arrive."
        }
      ],
      "@maplibre/maplibre-react-native",
      [
        "expo-image-picker",
        {
          "photosPermission": "TableMeet uses your photos so you can choose a profile picture and share photos in chats.",
          "cameraPermission": "TableMeet uses your camera so you can take photos to share in chats.",
          "microphonePermission": "TableMeet uses your microphone to record voice messages in chats."
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "TableMeet uses your microphone to record voice messages in chats.",
          "enableBackgroundPlayback": false,
          "enableBackgroundRecording": false
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/notification-icon.png",
          "color": "#FE593B",
          "defaultChannel": "default"
        }
      ],
      [
        "react-native-google-mobile-ads",
        {
          "androidAppId": "ca-app-pub-3940256099942544~3347511713",
          "iosAppId": "ca-app-pub-3940256099942544~1458002511",
          "delayAppMeasurementInit": true
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "6bad4231-9dd1-4973-9176-101932f5ae4e"
      }
    },
    "owner": "tablemeets-team",
    "backgroundColor": "#0A0612"
  }
}
