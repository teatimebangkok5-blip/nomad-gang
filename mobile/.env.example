# Copy to .env.local and fill in. These values end up inside the app, so never put secret keys here.
# Supabase dashboard -> Project Settings -> API Keys (publishable key) and Data API (URL).
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# Google Cloud Console -> APIs & Services -> Credentials -> the "Web application" OAuth client ID.
# The same ID goes into Supabase -> Authentication -> Sign In / Providers -> Google -> Client IDs.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=1234567890-xxxx.apps.googleusercontent.com
