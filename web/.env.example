# Copy this file to .env.local and fill in the values from your Supabase project:
# Supabase dashboard -> Project Settings -> API (Data API URL) and API Keys.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# Secret key (server only, never NEXT_PUBLIC): Supabase dashboard -> Project Settings -> API Keys -> Secret keys.
# Used only by the staff QR page (/r/...) to check venue logins and redeem codes. On Vercel, add it as an
# environment variable (not exposed to the browser).
SUPABASE_SECRET_KEY=sb_secret_xxx

# Shown on the public Terms, Privacy and Delete account pages. Leave empty until you have them.
NEXT_PUBLIC_BUSINESS_NAME=
NEXT_PUBLIC_CONTACT_EMAIL=
